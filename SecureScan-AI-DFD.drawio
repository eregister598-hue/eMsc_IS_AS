        <mxCell id="tb3" parent="layer-tb" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;strokeWidth=2;fillColor=#f8f9fa;strokeColor=#6c757d;fontColor=#212529;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;arcSize=4;" value="&lt;b&gt;[TB3] Ingress DMZ &amp;amp; Reverse Proxy Boundary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: #495057;&quot;&gt;Network Ingress Perimeter (TLS 1.3 Termination &amp;amp; WAF)&lt;/font&gt;" vertex="1">
