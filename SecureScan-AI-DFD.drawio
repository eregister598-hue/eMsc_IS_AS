        <mxCell id="df11" edge="1" parent="layer-df" source="ds2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" target="p4" value="DF11: Pull Signed Scanner Image">
