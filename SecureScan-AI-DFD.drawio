        <mxCell id="df_int1" edge="1" parent="layer-df" source="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" target="p3" value="Forward Scan Request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df_int2" edge="1" parent="layer-df" source="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" target="p2" value="Verify Ingress Token &amp;amp; Scope">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df_int3" edge="1" parent="layer-df" source="ds1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" target="p6" value="Query Finding Records &amp;amp; Policies">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="df_int4" edge="1" parent="layer-df" source="ee3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" target="p1" value="Admin Config &amp;amp; Access Controls">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="layer-ann" parent="0" value="6-Annotations" />
        <mxCell id="ann_title" parent="layer-ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;align=left;spacingLeft=15;spacingTop=10;" value="&lt;font style=&quot;font-size: 15px; font-weight: bold; color: #7f6000;&quot;&gt;SecureScan-AI Platform&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px; font-weight: bold; color: #333333;&quot;&gt;Level 1 Threat Modeling Data Flow Diagram (DFD)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #555555;&quot;&gt;Standard: Yourdon-DeMarco &amp;amp; Microsoft SDL | Security Framework: OWASP Top 10:2021&lt;br&gt;Boundaries: TB1–TB6 | Entities: EE1–EE4 | Processes: P1–P6 | Stores: DS1–DS4 | Flows: DF1–DF11&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="50" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ann_legend" parent="layer-ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;align=left;spacingLeft=20;spacingTop=12;fontColor=#333333;" value="&lt;b&gt;DIAGRAM LEGEND &amp;amp; NOTATION HIERARCHY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;[TB1–TB6] Trust Boundaries:&lt;/b&gt; Grey Dashed Enclosures defining perimeter isolation &amp;amp; privilege tiers.&lt;br&gt;&lt;b&gt;[EE1–EE4] External Entities:&lt;/b&gt; Blue Rectangles representing human users (Dev, Manager, Admin) &amp;amp; Cloud IdP.&lt;br&gt;&lt;b&gt;[P1–P6] Processes:&lt;/b&gt; Green Rounded Rectangles representing services &amp;amp; containerized execution nodes.&lt;br&gt;&lt;b&gt;[DS1–DS4] Data Stores:&lt;/b&gt; Orange Cylinders representing persistent databases, registries, vaults &amp;amp; audit trails.&lt;br&gt;&lt;b&gt;[DF1–DF11] Data Flows:&lt;/b&gt; Solid Black Directed Arrows denoting authenticated payloads and token-mediated exchanges.&lt;br&gt;&lt;b&gt;[Annotations]:&lt;/b&gt; Yellow Cards detailing architectural controls, trust assumptions &amp;amp; security governance." vertex="1">
          <mxGeometry height="140" width="1560" x="50" y="740" as="geometry" />
        </mxCell>
        <mxCell id="ann_notes" parent="layer-ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;shadow=1;align=left;spacingLeft=20;spacingTop=12;fontColor=#333333;" value="&lt;b&gt;ARCHITECTURAL THREAT MITIGATION SPECIFICATIONS (STRIDE ALIGNED)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Spoofing Mitigation (EE1/EE4/P2):&lt;/b&gt; All ingress requests terminate TLS 1.3 at P1. OIDC tokens cryptographically verified by P2; internal microservices require mutual TLS (mTLS) with ephemeral X.509 certs.&lt;br&gt;&lt;b&gt;2. Tampering Mitigation (P4/DS2):&lt;/b&gt; Scanner containers execute with read-only root filesystems, dropped Linux capabilities (CAP_DROP_ALL), and gVisor sandboxing. Container images signed via Cosign in DS2.&lt;br&gt;&lt;b&gt;3. Repudiation Mitigation (DS4/P1):&lt;/b&gt; High-fidelity security audit events stream directly to immutable append-only SIEM store (DS4). Cryptographic hash chaining prevents log alteration.&lt;br&gt;&lt;b&gt;4. Information Disclosure Mitigation (DS1/DS3):&lt;/b&gt; DS1 enforces AES-256 transparent data encryption at rest. Sensitive source code in P4 is held in transient memory tmpfs mounts and purged immediately.&lt;br&gt;&lt;b&gt;5. Denial of Service Mitigation (P1/P3):&lt;/b&gt; API Gateway P1 implements token-bucket rate limiting by IP and User-ID. Scan Orchestrator P3 enforces queue quotas, max runtime timeouts, and container memory limits.&lt;br&gt;&lt;b&gt;6. Elevation of Privilege Mitigation (P1/P2/EE3):&lt;/b&gt; Strict Role-Based Access Control (RBAC) enforced across API routes. Unprivileged runner P4 is prohibited from mounting the host Docker daemon socket." vertex="1">
          <mxGeometry height="180" width="1560" x="50" y="895" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
