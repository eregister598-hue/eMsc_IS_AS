        <mxCell id="df10" edge="1" parent="layer-df" source="ds3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11;endArrow=classic;labelBackgroundColor=#ffffff;" target="p3" value="DF10: Secrets &amp;amp; Credentials">
